{
  "description": "Closes the tabs and apps Wisply opened when Claude finishes a reply (wisply config cleanup off keeps them), names a learned routine that fits the user's request, and keeps the Wisply memory: a short start summary, notes that fit a request, sessions queued for local learning (wisply memory off turns it off), and shortens long Bash logs and JSON to their important lines with the full text kept in ~/.wisply/headroom/out (a file ~/.wisply/headroom/off turns that off), and after each edit names new weak spots wisply think finds in that file (~/.wisply/think/quick-off turns that off)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${WISPLY_HOME:-$HOME/.wisply}/bin/${WISPLY_CLIENT:-wisply.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${WISPLY_CLIENT:-wisply.exe}\"; \"$L\" hook start",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${WISPLY_HOME:-$HOME/.wisply}/bin/${WISPLY_CLIENT:-wisply.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${WISPLY_CLIENT:-wisply.exe}\"; \"$L\" done --quiet",
            "timeout": 15,
            "async": true
          },
          {
            "type": "command",
            "command": "L=\"${WISPLY_HOME:-$HOME/.wisply}/bin/${WISPLY_CLIENT:-wisply.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${WISPLY_CLIENT:-wisply.exe}\"; \"$L\" hook stop",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${WISPLY_HOME:-$HOME/.wisply}/bin/${WISPLY_CLIENT:-wisply.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${WISPLY_CLIENT:-wisply.exe}\"; \"$L\" hook compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${WISPLY_HOME:-$HOME/.wisply}/bin/${WISPLY_CLIENT:-wisply.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${WISPLY_CLIENT:-wisply.exe}\"; \"$L\" hook end",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${WISPLY_HOME:-$HOME/.wisply}/bin/${WISPLY_CLIENT:-wisply.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${WISPLY_CLIENT:-wisply.exe}\"; \"$L\" suggest",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${WISPLY_HOME:-$HOME/.wisply}/bin/${WISPLY_CLIENT:-wisply.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${WISPLY_CLIENT:-wisply.exe}\"; \"$L\" hook post",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
