{
  "description": "Closes the tabs and apps Lighting opened when Claude finishes a reply (lighting config cleanup off keeps them), names a learned routine that fits the user's request, and keeps the Lighting memory: a short start summary, notes that fit a request, sessions queued for local learning (lighting memory off turns it off)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${LIGHTING_HOME:-$HOME/.lighting}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; \"$L\" hook start",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${LIGHTING_HOME:-$HOME/.lighting}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; \"$L\" done --quiet",
            "timeout": 15,
            "async": true
          },
          {
            "type": "command",
            "command": "L=\"${LIGHTING_HOME:-$HOME/.lighting}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; \"$L\" hook stop",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${LIGHTING_HOME:-$HOME/.lighting}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; \"$L\" hook compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${LIGHTING_HOME:-$HOME/.lighting}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; \"$L\" hook end",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "L=\"${LIGHTING_HOME:-$HOME/.lighting}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; [ -f \"$L\" ] || L=\"${CLAUDE_PLUGIN_ROOT}/bin/${LIGHTING_CLIENT:-lighting.exe}\"; \"$L\" suggest",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
