{
  "manifest_version": 3,
  "name": "Lighting",
  "version": "0.2.0",
  "description": "Lets Claude Code drive this browser through the local lighting command. Talks only to the Lighting native host on this PC.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "scripting",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "downloads",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
